# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA
public/sw.js
public/workbox-*.js
public/worker-*.js

# Seeded design canvases. These are build output: ~2MB of editor payload each,
# regenerated from the .dc.html sources beside them whenever the design is
# republished. The sources and canvas.json are the parts worth keeping.
.design/**/*.html
!.design/**/*.dc.html

# The canvas runtime that renders those sources. Generated, "do not edit" on
# line one, and re-fetched with the design whenever it is needed.
.design/**/*.js

# Android TV agent build output
ps5-tv-agent/.gradle/
ps5-tv-agent/build/
ps5-tv-agent/app/build/
ps5-tv-agent/local.properties
ps5-tv-agent/.idea/

# PS5 Pi agent — secrets and local state
ps5-pi-agent/config.json
ps5-pi-agent/station.json
ps5-pi-agent/switch-state.json
ps5-pi-agent/__pycache__/
ps5-pi-agent/**/__pycache__/
