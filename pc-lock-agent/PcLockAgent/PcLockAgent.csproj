<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe) means no console window appears behind the app. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PcLockAgent</RootNamespace>
    <AssemblyName>PcLockAgent</AssemblyName>

    <!--
      PerMonitorV2 DPI awareness matters a lot here: this app sizes itself to
      the exact pixel bounds of the screen. Without it, Windows would scale the
      window for us on a display running at 125%/150%, leaving the "fullscreen"
      lock screen blurry and slightly the wrong size (often with a visible strip
      of desktop along one edge).
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />

    <!--
      Draws the QR on the lock screen. Pure managed code with no native
      dependency, so the self-contained single-file publish is unaffected.
      Generating locally rather than downloading an image means the screen can
      still draw a code it already holds if the next fetch fails.
    -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PreserveNewest, not Always: this file holds the station id and broker
      address, which are edited per machine. Copying on every build would
      overwrite a café PC's real settings with the repo's localhost defaults.
    -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!--
      Per-machine secrets, git-ignored. Conditional because most checkouts will
      not have one, and an unconditional Update on a missing file is a warning.
    -->
    <None Update="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
